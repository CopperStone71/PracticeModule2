<Page x:Class="Practice2.Pages.AddEmployee"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practice2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEmployee">

    <Grid>
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Text="Добавление пользователя" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Имя:" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="tbName" Text="" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Фамилия:" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="tbSurname" Text="" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Отчество:" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="tbPatronumic" Text="" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Номер телефона:" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="tbPhoneNumber" Text="" Width="200"/>
            </StackPanel>
            <Button Margin="5,15,5,5" Content="Добавить" Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
