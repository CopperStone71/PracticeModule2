<Page x:Class="Practice2.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practice2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autho"
      Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- Блок с вводом логина, пароля и капчи -->
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>
            <TextBlock Text="Пароль:"/>
            <TextBox x:Name="tbPassword"/>
            <TextBlock  x:Name="txtBlockCaptcha" Text="Капча:" Visibility="Hidden"/>
            <TextBox  x:Name="txtboxCaptcha" Visibility="Hidden"/>
            <TextBlock Visibility="Hidden" x:Name="txtBlockTimer" Text="" Foreground="Red"/>

            <!-- Блок кнопок входа -->
            <StackPanel Orientation="Horizontal" Height="55" HorizontalAlignment="Center" >
                <Button x:Name="btnEnterGuests" Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Content="Войти" Click="btnEnter_Click"/>
                <Button x:Name="btnLostPassword" Content="Забыли пароль" Click="btnLostPassword_Click"/>
            </StackPanel>

            <!-- Блок для замены пароля -->
            <TextBlock  x:Name="tblEmail" Text="Введите почту:" Visibility="Hidden"/>
            <TextBox  x:Name="tbEmail" Visibility="Hidden"/>
            <StackPanel Orientation="Horizontal" Height="55" HorizontalAlignment="Center" >
                <Button x:Name="btnSendCode" Content="Отправить код" Click="btnSendCode_Click" Visibility="Hidden"/>
                <Button x:Name="btnCheckCode" Content="Проверить код" Click="btnCheckCode_Click" Visibility="Hidden"/>
                <Button x:Name="btnChangePassword" Content="Сменить пароль" Click="btnChangePassword_Click" Visibility="Hidden"/>
            </StackPanel>
            <TextBlock  x:Name="tblNewPassword" Text="Новый пароль:" Visibility="Hidden"/>
            <TextBox  x:Name="tbNewPassword" Visibility="Hidden"/>
        </StackPanel>
    </Grid>
</Page>
